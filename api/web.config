<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración para publicar la API bajo IIS en Windows.
  Requiere el "ASP.NET Core Hosting Bundle" instalado en el servidor.
  El módulo AspNetCoreModuleV2 arranca MedicosApi.dll dentro del worker de IIS.
  Nota: bajo IIS (hosting in-process) el binding lo controla el sitio de IIS,
  por lo que la llamada UseUrls(:5000) del Program.cs se ignora; configurá el
  puerto en el binding del sitio de IIS.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\MedicosApi.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
